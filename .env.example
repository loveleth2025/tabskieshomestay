# URL of the n8n Webhook node that receives new bookings.
# See README.md "n8n webhook contract" for the exact payload shape.
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/tabskies-booking

# Business contact details shown on the invoice / confirmation.
NEXT_PUBLIC_BUSINESS_NAME="Tabskie's Homestay and Travel"
NEXT_PUBLIC_BUSINESS_EMAIL=tabskiestravel@email.com
NEXT_PUBLIC_BUSINESS_PHONE="+63 9XX XXX XXXX"

# --- Internal dashboard (/admin) ---

# HTTP Basic Auth credentials that gate /admin/*. Required — the dashboard
# refuses to serve pages until ADMIN_PASSWORD is set.
ADMIN_USERNAME=tabskies
ADMIN_PASSWORD=change-me

# Optional: once your n8n Reservation Management workflow can serve reads,
# point these here and the dashboard switches from its built-in demo data
# to your real sheet. Leave both unset to keep using demo data.
# GET endpoint returning { "reservations": [ ... ] } (see README for shape).
N8N_RESERVATIONS_WEBHOOK_URL=
# POST endpoint receiving { "id": "...", "action": { "type": "confirm" } }.
N8N_RESERVATION_ACTION_WEBHOOK_URL=
